# Copy to .env.local and fill in your Supabase project's values.
# .env* is gitignored (except this example file) — never commit real keys.

# --- Supabase: required ---------------------------------------------------
# Project Settings -> API. Both of these ship to the browser, which is fine:
# the anon key is only as powerful as your RLS policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely, so it must never be prefixed
# NEXT_PUBLIC_ and never be committed. Used by the admin routes, the points
# writes, and the scripts in scripts/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site URL: required in production ------------------------------------
# The canonical origin, no trailing slash. Feeds metadataBase, so it decides
# what URL every OG/Twitter card and canonical link points at, and what
# sitemap.xml/robots.txt advertise. Wrong here means every share preview and
# every indexed URL points somewhere wrong.
# Local development can leave this unset — it falls back to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- UPI collection for /advertise: optional ------------------------------
# Leave unset and the advertising form drops its payment step and says we
# will send details once the slot is confirmed — which matches the manual
# review-then-publish flow. Set the VPA and the step appears.
# A VPA is a payment address meant to be shown to a payer, like an account
# number on an invoice, so NEXT_PUBLIC_ is correct for it.
# NEXT_PUBLIC_UPI_ID=yourbusiness@okhdfcbank
# NEXT_PUBLIC_UPI_PAYEE_NAME=Your Business Name
# Path under public/, or an absolute URL. Optional — a VPA alone is usable.
# NEXT_PUBLIC_UPI_QR_URL=/upi-qr.png

# --- Legal / operator details: required in production --------------------
# Shown on /privacy, /terms and /refunds. A production build FAILS while
# these are unset — see the guard in lib/legal.ts. Google OAuth
# verification and payment onboarding both read those pages, so a
# placeholder business name or contact address blocks you at both gates.
NEXT_PUBLIC_LEGAL_ENTITY=Your Registered Business Name
NEXT_PUBLIC_LEGAL_EMAIL=hello@your-domain.com
